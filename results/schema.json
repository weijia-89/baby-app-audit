{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/weijia-89/baby-app-audit/results/schema.json",
  "title": "APK Privacy Test Results",
  "description": "Machine-readable results from the APK Privacy Test Harness",
  "type": "object",
  "required": ["harness_version", "timestamp", "test_run_id", "apps"],
  "properties": {
    "harness_version": {
      "type": "string",
      "description": "Version of the test harness used"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of test completion"
    },
    "test_run_id": {
      "type": "string",
      "description": "Unique identifier for this test run"
    },
    "test_environment": {
      "type": "object",
      "properties": {
        "host_os": { "type": "string" },
        "host_arch": { "type": "string" },
        "android_api_level": {
          "type": "integer",
          "description": "Do not set this on a mixed run. API level is per capture. Use api_level."
        },
        "api_level": {
          "type": "string",
          "description": "Per-capture API note. Do not invent a level for a window with no manifest."
        },
        "emulator_arch": { "type": "string" },
        "tool_versions": {
          "type": "object",
          "properties": {
            "adb": { "type": "string" },
            "mitmproxy": { "type": "string" },
            "jadx": { "type": "string" },
            "docker": { "type": "string" },
            "objection": { "type": "string" }
          }
        }
      }
    },
    "apps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "package_name", "app_type", "verdict", "privacy_class"],
        "properties": {
          "name": {
            "type": "string",
            "description": "App name (display name, not slug)"
          },
          "package_name": { "type": "string" },
          "app_type": {
            "type": "string",
            "enum": ["native", "web", "foss", "hybrid"]
          },
          "apk_hash": {
            "type": "object",
            "properties": {
              "sha256": { "type": "string" },
              "timestamp": { "type": "string", "format": "date-time" },
              "source": { "type": "string", "enum": ["device", "mirror", "build"] }
            }
          },
          "verdict": {
            "type": "string",
            "enum": ["pass", "fail", "untested", "not-assessable", "inconclusive", "provisional_pass"],
            "description": "Claim axis. pass only when the tested sentence is met. fail only with UID, a body field that names the package, or an R4 line."
          },
          "privacy_class": {
            "type": "string",
            "enum": ["pass", "minor", "major", "untested"],
            "description": "Derived from the committed network log. untested when no flow stores a UID or a body key that names the package. Not taken from the report emoji."
          },
          "gate": {
            "type": "string",
            "description": "Stored negative-gate status. G1-G10 not stored until a verdict file records the flags."
          },
          "verdict_confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "evidence": { "type": "string" },
          "offline_test": {
            "type": "object",
            "properties": {
              "outbound_requests_count": { "type": "integer" },
              "outbound_destinations": {
                "type": "array",
                "items": { "type": "string" }
              },
              "flow_file": { "type": "string" }
            }
          },
          "static_scan": {
            "type": "object",
            "properties": {
              "trackers_found": { "type": "integer" },
              "tracker_names": {
                "type": "array",
                "items": { "type": "string" }
              },
              "permissions": {
                "type": "array",
                "items": { "type": "string" }
              },
              "exodus_report": { "type": "string" },
              "source_hits": { "type": "string" },
              "note": { "type": "string" }
            }
          },
          "dynamic_capture": {
            "type": "object",
            "properties": {
              "destinations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "address": { "type": "string" },
                    "is_tracker": { "type": "boolean" },
                    "tracker_source": { "type": "string" },
                    "protocol": { "type": "string" },
                    "payload_size_bytes": { "type": "integer" }
                  }
                }
              },
              "covert_channels_checked": {
                "type": "array",
                "items": { "type": "string" }
              },
              "pinning_bypass_required": { "type": "boolean" },
              "flow_file": { "type": "string" }
            }
          },
          "source_audit": {
            "type": "object",
            "properties": {
              "repository_url": { "type": "string" },
              "commit_hash": { "type": "string" },
              "network_endpoints": {
                "type": "array",
                "items": { "type": "string" }
              },
              "tracker_libraries": {
                "type": "array",
                "items": { "type": "string" }
              },
              "sends_by_default": { "type": "boolean" },
              "network_references_count": { "type": "integer" },
              "tracker_references_count": { "type": "integer" }
            }
          }
        }
      }
    },
    "audit_log": {
      "type": "object",
      "properties": {
        "log_file": { "type": "string" },
        "hash_chain": { "type": "string" },
        "entries_count": { "type": "integer" }
      }
    },
    "compliance": {
      "type": "object",
      "properties": {
        "dpia_completed": { "type": "boolean" },
        "consent_obtained": { "type": "boolean" },
        "purpose_documented": { "type": "boolean" },
        "retention_days": { "type": "integer" }
      }
    }
  }
}
