{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/weijia-89/baby-app-audit/results/decode-traffic.schema.json",
  "title": "Decode Traffic Schema v2",
  "description": "Schema for decoded network traffic from HAR captures",
  "type": "object",
  "required": ["$schema", "schema_version", "package_name", "capture_timestamp", "flows"],
  "properties": {
    "$schema": {
      "type": "string",
      "enum": ["decode-traffic/2.0"],
      "description": "Schema identifier for this document"
    },
    "schema_version": {
      "type": "string",
      "enum": ["2.0"],
      "description": "Semantic version of this schema"
    },
    "package_name": {
      "type": "string",
      "description": "Android package name or web app identifier"
    },
    "capture_timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of capture start"
    },
    "tool_versions": {
      "type": "object",
      "properties": {
        "mitmproxy": { "type": "string" },
        "frida": { "type": "string" },
        "exodus_cli": { "type": "string" }
      }
    },
    "flows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["timestamp", "request", "response"],
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 timestamp of this flow"
          },
          "request": {
            "type": "object",
            "required": ["method", "url"],
            "properties": {
              "method": {
                "type": "string",
                "enum": ["GET", "POST", "PUT", "DELETE", "PATCH", "OPTIONS", "HEAD", "CONNECT", "TRACE"]
              },
              "url": { "type": "string", "format": "uri" },
              "host": { "type": "string" },
              "headers": {
                "type": "object",
                "additionalProperties": { "type": "string" }
              },
              "body": { "type": ["string", "object", "null"] },
              "body_size_bytes": { "type": "integer", "minimum": 0 }
            }
          },
          "response": {
            "type": "object",
            "required": ["status"],
            "properties": {
              "status": { "type": "integer" },
              "headers": {
                "type": "object",
                "additionalProperties": { "type": "string" }
              },
              "body": { "type": ["string", "object", "null"] },
              "body_size_bytes": { "type": "integer", "minimum": 0 }
            }
          },
          "classification": {
            "type": "object",
            "properties": {
              "is_tracker": { "type": "boolean" },
              "tracker_source": { "type": "string" },
              "protocol": { "type": "string" },
              "mechanism": {
                "type": "string",
                "enum": ["realtime_bidding", "data_broker_sale", "analytics", "crash_reporting", "firebase", "unknown"],
                "description": "realtime_bidding vs data_broker_sale are distinct mechanisms per S4.2 canon"
              }
            }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "total_flows": { "type": "integer", "minimum": 0 },
        "tracker_flows": { "type": "integer", "minimum": 0 },
        "unique_destinations": {
          "type": "array",
          "items": { "type": "string" }
        },
        "unique_trackers": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "product_metadata": {
      "type": "object",
      "description": "Per-product retention, security, and regulatory fields",
      "properties": {
        "retention_schedule": {
          "type": "object",
          "properties": {
            "policy_days": { "type": "integer", "minimum": 0 },
            "policy_description": { "type": "string" },
            "indefinite": { "type": "boolean" }
          }
        },
        "security_eol": {
          "type": "object",
          "properties": {
            "eol_date": { "type": "string", "description": "ISO 8601 date or 'unknown' if not available" },
            "device_model": { "type": "string" },
            "eol_confidence": { "type": "string", "enum": ["confirmed", "estimated", "unknown"] }
          }
        },
        "cve_list": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "cve_id": { "type": "string", "pattern": "^CVE-[0-9]{4}-[0-9]+$" },
              "severity": { "type": "string", "enum": ["critical", "high", "medium", "low", "unknown"] },
              "description": { "type": "string" }
            }
          }
        },
        "regulatory_regime": {
          "type": "string",
          "enum": ["MDR", "RED", "COPPA", "GDPR", "unknown"],
          "description": "MDR = Medical Device Regulation (EU), RED = Radio Equipment Directive (EU)"
        },
        "device_identity": {
          "type": "object",
          "properties": {
            "basic_udi_di": { "type": "string" },
            "model_number": { "type": "string" },
            "regime": {
              "type": "string",
              "enum": ["MDR", "RED", "unknown"]
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
