{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/weijia-89/baby-app-audit/results/capture-manifest.schema.json",
  "title": "Capture window manifest",
  "description": "Canon fields for one capture window. A missing value is the string unknown. source is the lockdown reading source. A filled value names its file as (source: results/...).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "avd_image",
    "api_level",
    "system_ca_present",
    "http_proxy_readback",
    "r1_mode",
    "pcapdroid_version",
    "uid_path",
    "app_filter",
    "r2_mode",
    "r3_mode",
    "lockdown_state",
    "source",
    "captive_portal_mode",
    "private_dns_mode",
    "firebase_debug_condition",
    "r4_log",
    "webview_version",
    "user_agent",
    "installed_packages",
    "uid_unknown_count",
    "conversion_events",
    "decoders"
  ],
  "properties": {
    "avd_image": { "type": "string" },
    "api_level": { "type": "string" },
    "system_ca_present": { "type": "string" },
    "http_proxy_readback": { "type": "string" },
    "r1_mode": { "type": "string" },
    "pcapdroid_version": { "type": "string" },
    "uid_path": { "type": "string" },
    "app_filter": { "type": "string" },
    "r2_mode": { "type": "string" },
    "r3_mode": { "type": "string" },
    "lockdown_state": { "type": "string" },
    "source": { "type": "string" },
    "captive_portal_mode": { "type": "string" },
    "private_dns_mode": { "type": "string" },
    "firebase_debug_condition": { "type": "string" },
    "r4_log": { "type": "string" },
    "webview_version": { "type": "string" },
    "user_agent": { "type": "string" },
    "installed_packages": { "type": "string" },
    "uid_unknown_count": { "type": "string" },
    "conversion_events": { "type": "string" },
    "decoders": { "type": "string" }
  }
}
