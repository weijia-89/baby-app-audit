{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Per-app network log (sanitized)",
  "type": "object",
  "required": [
    "$schema",
    "schema_version",
    "app",
    "package_name",
    "capture_date",
    "flows",
    "summary"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": "1.0"
    },
    "app": {
      "type": "string"
    },
    "package_name": {
      "type": "string"
    },
    "capture_date": {
      "type": "string"
    },
    "capture": {
      "type": "string"
    },
    "redaction": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "required": ["policy", "slugs", "body_keys"],
          "properties": {
            "policy": { "type": "string" },
            "slugs": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            },
            "body_keys": { "type": "string" }
          },
          "additionalProperties": false
        }
      ]
    },
    "note": {
      "type": "string"
    },
    "flows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "method",
          "host",
          "path"
        ],
        "properties": {
          "method": {
            "type": "string"
          },
          "host": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "status": {
            "oneOf": [
              { "type": "integer" },
              { "const": "unknown" },
              { "type": "null" }
            ]
          },
          "outcome": {
            "const": "no_response"
          },
          "x_android_package": {
            "type": ["string", "null"]
          },
          "query_params": {
            "type": "array",
            "items": { "type": "string" }
          },
          "origin": {
            "type": "string",
            "description": "app = request carries the app's own package header; device = carries another package header (e.g. Play services); session = no package header"
          },
          "count": {
            "type": "integer",
            "description": "Number of identical flows merged into this row; enriched logs only"
          },
          "request": {
            "type": "object",
            "description": "Sanitized request detail; enriched logs only",
            "properties": {
              "size": { "type": "integer" },
              "content_type": { "type": ["string", "null"] },
              "body_keys": {
                "type": ["array", "null"],
                "items": { "type": "string" }
              },
              "body_decoder": {
                "type": ["string", "null"]
              },
              "unscannable": {
                "type": "boolean"
              },
              "headers": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          },
          "response": {
            "type": "object",
            "description": "Sanitized response detail; enriched logs only",
            "properties": {
              "size": { "type": "integer" },
              "content_type": { "type": ["string", "null"] },
              "body_keys": {
                "type": ["array", "null"],
                "items": { "type": "string" }
              },
              "body_decoder": {
                "type": ["string", "null"]
              },
              "unscannable": {
                "type": "boolean"
              }
            }
          },
          "redactions": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Descriptive slugs for values removed from this flow. Call metadata remains present."
          }
        }
      }
    },
    "tls_unread": {
      "type": "array",
      "items": { "type": "object" }
    },
    "non_http": {
      "type": "array",
      "items": { "type": "object" }
    },
    "summary": {
      "type": "object",
      "required": [
        "total_flows",
        "unique_destinations"
      ],
      "properties": {
        "total_flows": {
          "type": "integer"
        },
        "unique_destinations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tracked": {
          "type": "string"
        }
      }
    }
  }
}
