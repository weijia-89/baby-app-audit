# Never commit binaries or third-party decompiled code
apks/
decompiled/

# Network captures may contain live tokens (Firebase JWTs, installation IDs).
# They are evidence but must stay local unless explicitly scrubbed.
results/mitm-capture/
results/*-test-*/
*.mitm
*.pid

# Decoded traffic JSONs and HAR conversions contain the same live tokens as .mitm captures.
results/har-inputs/
results/decode-traffic-*.json

# Runtime logs (noise, may contain device identifiers)
results/execution-logs/
results/baby-buddy-dynamic/
results/baby-buddy-test-20260803/

# Local review artifacts (trainer loop)
localonly/

# Roadmap prompts - keep only roadmap.md in root
ROADMAP-PROMPT-v*.md

# Python test virtual environment
.test-venv/

# Internal review artifacts
.agent/

# Prompts are local-only working material (research/closeout drafts). Never commit.
prompts/
