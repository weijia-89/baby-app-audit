{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/weijia-89/baby-app-audit/prompts/output-schema.json",
  "title": "Research Prompt Output Schema",
  "description": "Common schema for all research prompt outputs",
  "type": "object",
  "required": ["$schema", "prompt_id", "date"],
  "properties": {
    "$schema": {
      "type": "string",
      "enum": ["prompt-output/1.0"]
    },
    "prompt_id": {
      "type": "string",
      "enum": ["01-apps", "02-rubric", "03-gaps", "04-identities"]
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "apps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "platform", "package_name", "category", "source", "source_url", "confidence"],
        "properties": {
          "name": { "type": "string" },
          "platform": { "type": "string", "enum": ["Android", "iOS", "both"] },
          "package_name": { "type": "string" },
          "category": { "type": "string", "enum": ["baby_tracker", "pregnancy", "fertility", "parenting", "wearable_iot"] },
          "source": { "type": "string" },
          "source_url": { "type": "string", "format": "uri" },
          "download_estimate": { "type": "string" },
          "privacy_posture": { "type": "string", "enum": ["claims_offline", "claims_local_first", "admits_cloud", "unknown"] },
          "why_interesting": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 100 },
          "confidence_reason": { "type": "string" }
        }
      }
    },
    "scoring_dimensions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "description", "score_range", "tiers", "evidence_type", "source", "confidence"],
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "score_range": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 2,
            "maxItems": 2
          },
          "tiers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "score": { "type": "number" },
                "label": { "type": "string" },
                "criteria": { "type": "string" }
              }
            }
          },
          "evidence_type": { "type": "string" },
          "source": { "type": "string", "format": "uri" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 100 }
        }
      }
    },
    "studies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "authors", "year", "url", "topic", "method", "key_finding", "confidence"],
        "properties": {
          "title": { "type": "string" },
          "authors": { "type": "string" },
          "year": { "type": "integer" },
          "venue": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "topic": { "type": "string" },
          "method": { "type": "string", "enum": ["static_analysis", "network_capture", "policy_analysis", "user_study"] },
          "key_finding": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 100 },
          "confidence_reason": { "type": "string" }
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["description", "severity", "recommendation", "feeds_into"],
        "properties": {
          "description": { "type": "string" },
          "severity": { "type": "string", "enum": ["high", "medium", "low"] },
          "recommendation": { "type": "string" },
          "feeds_into": { "type": "string" }
        }
      }
    },
    "devices": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "manufacturer", "model_number", "udi_di_status", "regime", "regime_evidence", "regime_source", "confidence"],
        "properties": {
          "name": { "type": "string" },
          "manufacturer": { "type": "string" },
          "model_number": { "type": "string" },
          "basic_udi_di": { "type": "string" },
          "udi_di_status": { "type": "string", "enum": ["not_found", "found", "not_required"] },
          "regime": { "type": "string", "enum": ["MDR", "RED", "both", "unknown"] },
          "regime_evidence": { "type": "string" },
          "regime_source": { "type": "string", "format": "uri" },
          "eudamed_query_date": { "type": "string", "format": "date" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 100 },
          "confidence_reason": { "type": "string" }
        }
      }
    }
  }
}
